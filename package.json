{
  "name": "alphaino",
  "version": "0.0.1",
  "description": "AlphainO: the AlphainZ research assistant inside Obsidian.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node esbuild.config.mjs production && cp build/main.js build/main.cjs && node tests/smoke/smoke.cjs build/main.cjs"
  },
  "devDependencies": {
    "@lexical/react": "^0.43.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.8",
    "jotai": "^2.12.1",
    "jsdom": "^27.0.1",
    "lexical": "^0.43.0",
    "obsidian": "1.14.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
