{
  // The shared packages (@beaver/agent-core, agent-llm, agent-ui) are compiled
  // from AlphainZ's source: from the AlphainZ repository next to this one when
  // developing, from the copy in shared/ in the public repository (the export
  // that makes it points these paths there). The third-party packages they
  // import resolve to this repository's copies, so the program has one React
  // and one jotai (esbuild.config.mjs does the same).
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@beaver/agent-core/*": ["./shared/packages/agent-core/src/*"],
      "@beaver/agent-llm/*": ["./shared/packages/agent-llm/src/*"],
      "@beaver/agent-ui/*": ["./shared/packages/agent-ui/src/*"],
      "@alphainz/i18n/*": ["./shared/src/i18n/*"],
      "react": ["./node_modules/@types/react"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "jotai": ["./node_modules/jotai"],
      "jotai/*": ["./node_modules/jotai/*"]
    }
  },
  "include": ["src", "tests"]
}
